{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lol-champions-tracker",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-08-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "lolchampionstracker.com", "custom_domain": true },
    { "pattern": "www.lolchampionstracker.com/*", "zone_name": "lolchampionstracker.com" }
  ]
}
